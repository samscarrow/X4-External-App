<?xml version="1.0" encoding="utf-8"?>
<!--
  Co-captain command bridge: executes commands the External App server
  piggybacks on its /api/data reply. ui/ea.lua parses that reply and raises
  one UI-triggered event per command; the cues below perform the visible
  action. Action names/attributes validated against the game's
  libraries/md.xsd + libraries/common.xsd (X4 v9.x), extracted from 08.cat.
  See game-extension/COMMAND_BRIDGE.md for the protocol and payloads.
-->
<mdscript name="CoCaptainBridge" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <cues>
        <cue name="CoCaptain_OnNotify" instantiate="true">
            <conditions>
                <event_ui_triggered screen="'CoCaptainBridge'" control="'notify'" />
            </conditions>
            <actions>
                <show_notification text="event.param3.{'$text'}" />
            </actions>
        </cue>

        <cue name="CoCaptain_OnLogbook" instantiate="true">
            <conditions>
                <event_ui_triggered screen="'CoCaptainBridge'" control="'logbook'" />
            </conditions>
            <actions>
                <write_to_logbook category="general" title="event.param3.{'$title'}" text="event.param3.{'$text'}" />
            </actions>
        </cue>

        <!--
          set_guidance rides the vanilla guidance system (md/guidance.xml) - the
          same machinery the map's right-click "set guidance" uses. Note that
          guidance shares the single active-mission slot: an active mission
          supersedes it (vanilla GuidanceLost). Payload: { clear = true } or
          { sector = <macro id or exact known sector name>, x/y/z = km offset }.
        -->
        <cue name="CoCaptain_OnSetGuidance" instantiate="true">
            <conditions>
                <event_ui_triggered screen="'CoCaptainBridge'" control="'set_guidance'" />
            </conditions>
            <actions>
                <do_if value="@event.param3.{'$clear'}">
                    <signal_cue_instantly cue="md.Guidance.EndGuidance" param="true" />
                    <show_notification text="'Co-captain: guidance cleared'" />
                </do_if>
                <do_else>
                    <do_if value="event.param3.{'$sector'}?">
                        <set_value name="$SectorArg" exact="event.param3.{'$sector'}" />
                        <set_value name="$WantedMacro" exact="if macro.{$SectorArg}? then macro.{$SectorArg} else null" />
                        <set_value name="$Sector" exact="null" />
                        <find_sector name="$AllSectors" space="player.galaxy" multiple="true" />
                        <do_all exact="$AllSectors.count" counter="$i">
                            <do_if value="($WantedMacro and $AllSectors.{$i}.macro == $WantedMacro) or $AllSectors.{$i}.knownname == $SectorArg">
                                <set_value name="$Sector" exact="$AllSectors.{$i}" />
                            </do_if>
                        </do_all>
                    </do_if>
                    <do_else>
                        <set_value name="$Sector" exact="player.sector" />
                    </do_else>
                    <do_if value="$Sector">
                        <set_value name="$Offset" exact="null" />
                        <do_if value="event.param3.{'$x'}? or event.param3.{'$y'}? or event.param3.{'$z'}?">
                            <set_value name="$X" exact="if event.param3.{'$x'}? then event.param3.{'$x'} else 0" />
                            <set_value name="$Y" exact="if event.param3.{'$y'}? then event.param3.{'$y'} else 0" />
                            <set_value name="$Z" exact="if event.param3.{'$z'}? then event.param3.{'$z'} else 0" />
                            <set_value name="$Offset" exact="position.[$X * 1km, $Y * 1km, $Z * 1km]" />
                        </do_if>
                        <signal_cue_instantly cue="md.Guidance.NewTarget" param="[$Sector, $Offset]" />
                        <show_notification text="'Co-captain: guidance set to ' + $Sector.knownname" />
                    </do_if>
                    <do_else>
                        <show_notification text="'Co-captain: unknown sector ' + $SectorArg" />
                    </do_else>
                </do_else>
            </actions>
        </cue>

        <!--
          order_ship_to issues a real MoveWait ("Fly and Wait") order. Serves two
          command types: fly_my_ship_to (no 'ship' in payload -> the ship the
          player is aboard) and order_ship_to (ship named by idcode, e.g.
          'VYU-077', or exact known name; player-owned ships only). Guards
          refuse, with an in-game notice, when the target has no NPC captain or
          the player is at the helm. On success: ticker notice + logbook audit
          entry, and watcher cues report arrival or cancellation back to the
          logbook (which the events journal ingests, so the co-captain sees it).
        -->
        <cue name="CoCaptain_OnOrderShipTo" instantiate="true">
            <conditions>
                <event_ui_triggered screen="'CoCaptainBridge'" control="'order_ship_to'" />
            </conditions>
            <actions>
                <do_if value="event.param3.{'$ship'}?">
                    <set_value name="$ShipArg" exact="event.param3.{'$ship'}" />
                    <set_value name="$Ship" exact="null" />
                    <set_value name="$Matches" exact="0" />
                    <find_ship name="$AllShips" space="player.galaxy" owner="faction.player" multiple="true" />
                    <do_all exact="$AllShips.count" counter="$i">
                        <do_if value="$AllShips.{$i}.idcode == $ShipArg or $AllShips.{$i}.knownname == $ShipArg">
                            <set_value name="$Matches" operation="add" />
                            <do_if value="not $Ship">
                                <set_value name="$Ship" exact="$AllShips.{$i}" />
                            </do_if>
                        </do_if>
                    </do_all>
                    <do_if value="not $Ship">
                        <show_notification text="'Co-captain: no owned ship matches ' + $ShipArg" />
                    </do_if>
                    <do_elseif value="$Matches gt 1">
                        <show_notification text="'Co-captain: ' + $Matches + ' ships match ' + $ShipArg + ' - using ' + $Ship.knownname + ' ' + $Ship.idcode" />
                    </do_elseif>
                </do_if>
                <do_else>
                    <set_value name="$Ship" exact="player.occupiedship" />
                    <do_if value="not $Ship.exists or $Ship.isclass.spacesuit or not $Ship.isplayerowned">
                        <set_value name="$Ship" exact="null" />
                        <show_notification text="'Co-captain: you are not aboard a ship of ours'" />
                    </do_if>
                </do_else>
                <do_if value="$Ship">
                    <do_if value="$Ship.pilot == player.entity">
                        <show_notification text="'Co-captain: you have the helm of ' + $Ship.knownname + ' - set guidance instead'" />
                    </do_if>
                    <do_elseif value="not @$Ship.assignedpilot">
                        <show_notification text="'Co-captain: ' + $Ship.knownname + ' has no captain to take the order'" />
                    </do_elseif>
                    <do_else>
                        <do_if value="event.param3.{'$sector'}?">
                            <set_value name="$SectorArg" exact="event.param3.{'$sector'}" />
                            <set_value name="$WantedMacro" exact="if macro.{$SectorArg}? then macro.{$SectorArg} else null" />
                            <set_value name="$DestSector" exact="null" />
                            <find_sector name="$AllSectors" space="player.galaxy" multiple="true" />
                            <do_all exact="$AllSectors.count" counter="$i">
                                <do_if value="($WantedMacro and $AllSectors.{$i}.macro == $WantedMacro) or $AllSectors.{$i}.knownname == $SectorArg">
                                    <set_value name="$DestSector" exact="$AllSectors.{$i}" />
                                </do_if>
                            </do_all>
                        </do_if>
                        <do_else>
                            <set_value name="$DestSector" exact="player.sector" />
                        </do_else>
                        <do_if value="$DestSector">
                            <!-- MoveWait's destination param is type="position":
                                 always a [sector, position] pair. A bare sector
                                 makes the order finish instantly without moving. -->
                            <set_value name="$X" exact="if event.param3.{'$x'}? then event.param3.{'$x'} else 0" />
                            <set_value name="$Y" exact="if event.param3.{'$y'}? then event.param3.{'$y'} else 0" />
                            <set_value name="$Z" exact="if event.param3.{'$z'}? then event.param3.{'$z'} else 0" />
                            <set_value name="$Destination" exact="[$DestSector, position.[$X * 1km, $Y * 1km, $Z * 1km]]" />
                            <create_order id="'MoveWait'" object="$Ship" immediate="true" name="$MoveOrder">
                                <param name="destination" value="$Destination" />
                            </create_order>
                            <show_notification text="'Co-captain: ordered ' + $Ship.knownname + ' ' + $Ship.idcode + ' to fly to ' + $DestSector.knownname" />
                            <write_to_logbook category="general" title="'Co-captain order'" text="'Ordered ' + $Ship.knownname + ' ' + $Ship.idcode + ' (captain ' + $Ship.assignedpilot.knownname + ') to fly to ' + $DestSector.knownname" />
                        </do_if>
                        <do_else>
                            <show_notification text="'Co-captain: unknown sector ' + $SectorArg" />
                        </do_else>
                    </do_else>
                </do_if>
            </actions>
            <cues>
                <!-- Only lives when an order was actually created -->
                <cue name="CoCaptain_OrderWatch" onfail="cancel">
                    <conditions>
                        <check_value value="$MoveOrder?" />
                    </conditions>
                    <cues>
                        <cue name="CoCaptain_OrderDone">
                            <conditions>
                                <check_any>
                                    <event_object_order_finished object="$Ship" />
                                    <event_object_order_cancelled object="$Ship" />
                                </check_any>
                                <check_value value="event.param == $MoveOrder" />
                            </conditions>
                            <actions>
                                <do_if value="event.name == 'event_object_order_finished'">
                                    <show_notification text="'Co-captain: ' + $Ship.knownname + ' ' + $Ship.idcode + ' has arrived at ' + $DestSector.knownname" />
                                    <write_to_logbook category="general" title="'Co-captain order complete'" text="$Ship.knownname + ' ' + $Ship.idcode + ' arrived at ' + $DestSector.knownname" />
                                </do_if>
                                <do_else>
                                    <write_to_logbook category="general" title="'Co-captain order cancelled'" text="'Move order for ' + $Ship.knownname + ' ' + $Ship.idcode + ' to ' + $DestSector.knownname + ' was cancelled'" />
                                </do_else>
                            </actions>
                        </cue>
                    </cues>
                </cue>
            </cues>
        </cue>

        <!--
          clear_ship_orders: the undo. Cancels all orders on a named own ship
          (idcode or exact name), or the ship the player is aboard when no ship
          is named. The captain reverts to idling until given new orders.
        -->
        <cue name="CoCaptain_OnClearShipOrders" instantiate="true">
            <conditions>
                <event_ui_triggered screen="'CoCaptainBridge'" control="'clear_ship_orders'" />
            </conditions>
            <actions>
                <do_if value="event.param3.{'$ship'}?">
                    <set_value name="$ShipArg" exact="event.param3.{'$ship'}" />
                    <set_value name="$Ship" exact="null" />
                    <set_value name="$Matches" exact="0" />
                    <find_ship name="$AllShips" space="player.galaxy" owner="faction.player" multiple="true" />
                    <do_all exact="$AllShips.count" counter="$i">
                        <do_if value="$AllShips.{$i}.idcode == $ShipArg or $AllShips.{$i}.knownname == $ShipArg">
                            <set_value name="$Matches" operation="add" />
                            <do_if value="not $Ship">
                                <set_value name="$Ship" exact="$AllShips.{$i}" />
                            </do_if>
                        </do_if>
                    </do_all>
                    <do_if value="not $Ship">
                        <show_notification text="'Co-captain: no owned ship matches ' + $ShipArg" />
                    </do_if>
                    <do_elseif value="$Matches gt 1">
                        <show_notification text="'Co-captain: ' + $Matches + ' ships match ' + $ShipArg + ' - using ' + $Ship.knownname + ' ' + $Ship.idcode" />
                    </do_elseif>
                </do_if>
                <do_else>
                    <set_value name="$Ship" exact="player.occupiedship" />
                    <do_if value="not $Ship.exists or $Ship.isclass.spacesuit or not $Ship.isplayerowned">
                        <set_value name="$Ship" exact="null" />
                        <show_notification text="'Co-captain: you are not aboard a ship of ours'" />
                    </do_if>
                </do_else>
                <do_if value="$Ship">
                    <cancel_all_orders object="$Ship" />
                    <show_notification text="'Co-captain: belayed all orders on ' + $Ship.knownname + ' ' + $Ship.idcode" />
                    <write_to_logbook category="general" title="'Co-captain order'" text="'Cancelled all orders on ' + $Ship.knownname + ' ' + $Ship.idcode" />
                </do_if>
            </actions>
        </cue>

        <!--
          ping_ship: locate one of your ships. Sets the vanilla guidance marker
          onto the ship itself (guidance tracks moving components live) and
          reports its current sector in the ticker. HUD-only; an active mission
          supersedes the marker, same as set_guidance.
        -->
        <cue name="CoCaptain_OnPingShip" instantiate="true">
            <conditions>
                <event_ui_triggered screen="'CoCaptainBridge'" control="'ping_ship'" />
            </conditions>
            <actions>
                <set_value name="$ShipArg" exact="event.param3.{'$ship'}" />
                <set_value name="$Ship" exact="null" />
                <set_value name="$Matches" exact="0" />
                <find_ship name="$AllShips" space="player.galaxy" owner="faction.player" multiple="true" />
                <do_all exact="$AllShips.count" counter="$i">
                    <do_if value="$AllShips.{$i}.idcode == $ShipArg or $AllShips.{$i}.knownname == $ShipArg">
                        <set_value name="$Matches" operation="add" />
                        <do_if value="not $Ship">
                            <set_value name="$Ship" exact="$AllShips.{$i}" />
                        </do_if>
                    </do_if>
                </do_all>
                <do_if value="$Ship">
                    <signal_cue_instantly cue="md.Guidance.NewTarget" param="[$Ship, null]" />
                    <do_if value="$Matches gt 1">
                        <show_notification text="'Co-captain: ' + $Matches + ' ships match ' + $ShipArg + ' - marking ' + $Ship.knownname + ' ' + $Ship.idcode + ' in ' + $Ship.sector.knownname" />
                    </do_if>
                    <do_else>
                        <show_notification text="'Co-captain: ' + $Ship.knownname + ' ' + $Ship.idcode + ' is in ' + $Ship.sector.knownname" />
                    </do_else>
                </do_if>
                <do_else>
                    <show_notification text="'Co-captain: no owned ship matches ' + $ShipArg" />
                </do_else>
            </actions>
        </cue>
        <!--
          set_weapons_hold: weapons discipline for a ship that is too eager -
          e.g. an escort shredding mission targets that must survive. hold=true
          disarms all turrets (set_turrets_armed, persists until released) and
          issues an immediate cease_fire; hold=false re-arms. Ship named by
          idcode/exact name, or the ship the player is aboard when omitted.
        -->
        <cue name="CoCaptain_OnSetWeaponsHold" instantiate="true">
            <conditions>
                <event_ui_triggered screen="'CoCaptainBridge'" control="'set_weapons_hold'" />
            </conditions>
            <actions>
                <do_if value="event.param3.{'$ship'}?">
                    <set_value name="$ShipArg" exact="event.param3.{'$ship'}" />
                    <set_value name="$Ship" exact="null" />
                    <set_value name="$Matches" exact="0" />
                    <find_ship name="$AllShips" space="player.galaxy" owner="faction.player" multiple="true" />
                    <do_all exact="$AllShips.count" counter="$i">
                        <do_if value="$AllShips.{$i}.idcode == $ShipArg or $AllShips.{$i}.knownname == $ShipArg">
                            <set_value name="$Matches" operation="add" />
                            <do_if value="not $Ship">
                                <set_value name="$Ship" exact="$AllShips.{$i}" />
                            </do_if>
                        </do_if>
                    </do_all>
                    <do_if value="not $Ship">
                        <show_notification text="'Co-captain: no owned ship matches ' + $ShipArg" />
                    </do_if>
                    <do_elseif value="$Matches gt 1">
                        <show_notification text="'Co-captain: ' + $Matches + ' ships match ' + $ShipArg + ' - using ' + $Ship.knownname + ' ' + $Ship.idcode" />
                    </do_elseif>
                </do_if>
                <do_else>
                    <set_value name="$Ship" exact="player.occupiedship" />
                    <do_if value="not $Ship.exists or $Ship.isclass.spacesuit or not $Ship.isplayerowned">
                        <set_value name="$Ship" exact="null" />
                        <show_notification text="'Co-captain: you are not aboard a ship of ours'" />
                    </do_if>
                </do_else>
                <do_if value="$Ship">
                    <do_if value="@event.param3.{'$hold'}">
                        <set_turrets_armed object="$Ship" armed="false" />
                        <cease_fire object="$Ship" />
                        <show_notification text="'Co-captain: weapons hold on ' + $Ship.knownname + ' ' + $Ship.idcode" />
                        <write_to_logbook category="general" title="'Co-captain order'" text="'Weapons hold: turrets disarmed on ' + $Ship.knownname + ' ' + $Ship.idcode" />
                    </do_if>
                    <do_else>
                        <set_turrets_armed object="$Ship" armed="true" />
                        <show_notification text="'Co-captain: weapons free on ' + $Ship.knownname + ' ' + $Ship.idcode" />
                        <write_to_logbook category="general" title="'Co-captain order'" text="'Weapons free: turrets re-armed on ' + $Ship.knownname + ' ' + $Ship.idcode" />
                    </do_else>
                </do_if>
            </actions>
        </cue>

        <!--
          get_ship_loadout: on-demand armament report. Enumerates the ship's
          installed weapons and turrets (find_object_component, the vanilla
          idiom) plus aggregate DPS, and writes the report to the blackboard
          var $cocaptain_loadout; ui/ea.lua forwards it as `ship_loadout` on
          the next telemetry cycle. Ship named by idcode/exact name, or the
          ship the player is aboard when omitted.
        -->
        <cue name="CoCaptain_OnGetShipLoadout" instantiate="true">
            <conditions>
                <event_ui_triggered screen="'CoCaptainBridge'" control="'get_ship_loadout'" />
            </conditions>
            <actions>
                <do_if value="event.param3.{'$ship'}?">
                    <set_value name="$ShipArg" exact="event.param3.{'$ship'}" />
                    <set_value name="$Ship" exact="null" />
                    <find_ship name="$AllShips" space="player.galaxy" owner="faction.player" multiple="true" />
                    <do_all exact="$AllShips.count" counter="$i">
                        <do_if value="not $Ship and ($AllShips.{$i}.idcode == $ShipArg or $AllShips.{$i}.knownname == $ShipArg)">
                            <set_value name="$Ship" exact="$AllShips.{$i}" />
                        </do_if>
                    </do_all>
                    <do_if value="not $Ship">
                        <show_notification text="'Co-captain: no owned ship matches ' + $ShipArg" />
                    </do_if>
                </do_if>
                <do_else>
                    <set_value name="$Ship" exact="player.occupiedship" />
                    <do_if value="not $Ship.exists or $Ship.isclass.spacesuit">
                        <set_value name="$Ship" exact="null" />
                        <show_notification text="'Co-captain: you are not aboard a ship'" />
                    </do_if>
                </do_else>
                <do_if value="$Ship">
                    <find_object_component name="$Weapons" object="$Ship" class="class.weapon" multiple="true" checkoperational="false" />
                    <find_object_component name="$Turrets" object="$Ship" class="class.turret" multiple="true" checkoperational="false" />
                    <set_value name="$WeaponList" exact="[]" />
                    <do_all exact="@$Weapons.count" counter="$i">
                        <append_to_list name="$WeaponList" exact="if @$Weapons.{$i}.macro.name then $Weapons.{$i}.macro.name else 'unknown'" />
                    </do_all>
                    <!-- Weapon-group membership per weapon (parallel to $weapons): e.g. 'primary:1,2' -->
                    <set_value name="$GroupList" exact="[]" />
                    <do_all exact="@$Weapons.count" counter="$i">
                        <set_value name="$W" exact="$Weapons.{$i}" />
                        <set_value name="$IsPrimary" exact="not $W.isclass.missilelauncher" />
                        <set_value name="$Groups" exact="''" />
                        <do_all exact="4" counter="$g">
                            <set_value name="$InGroup" exact="false" />
                            <do_if value="$IsPrimary">
                                <set_value name="$InGroup" exact="@$Ship.primaryweapons.{$g}.list.indexof.{$W} gt 0" />
                            </do_if>
                            <do_else>
                                <set_value name="$InGroup" exact="@$Ship.secondaryweapons.{$g}.list.indexof.{$W} gt 0" />
                            </do_else>
                            <do_if value="$InGroup">
                                <set_value name="$Groups" exact="if $Groups == '' then '' + $g else $Groups + ',' + $g" />
                            </do_if>
                        </do_all>
                        <append_to_list name="$GroupList" exact="(if $IsPrimary then 'primary:' else 'secondary:') + $Groups" />
                    </do_all>
                    <set_value name="$TurretList" exact="[]" />
                    <do_all exact="@$Turrets.count" counter="$i">
                        <append_to_list name="$TurretList" exact="if @$Turrets.{$i}.macro.name then $Turrets.{$i}.macro.name else 'unknown'" />
                    </do_all>
                    <set_value name="player.entity.$cocaptain_loadout" exact="table[
                        $idcode = $Ship.idcode,
                        $name = $Ship.knownname,
                        $macro = if @$Ship.macro.name then $Ship.macro.name else '',
                        $weapons = $WeaponList,
                        $weapon_groups = $GroupList,
                        $active_primary_group = if @$Ship.activeweapongroup.primary then ($Ship.activeweapongroup.primary)i else 0,
                        $active_secondary_group = if @$Ship.activeweapongroup.secondary then ($Ship.activeweapongroup.secondary)i else 0,
                        $turrets = $TurretList,
                        $dps_all = if @$Ship.dps.all then ($Ship.dps.all)i else 0,
                        $dps_turrets = if @$Ship.dps.secondary then ($Ship.dps.secondary)i else 0,
                        $game_time = (player.age / 1s)i
                    ]" />
                    <show_notification text="'Co-captain: loadout report ready for ' + $Ship.knownname + ' ' + $Ship.idcode" />
                </do_if>
            </actions>
        </cue>

        <!--
          set_weapon_group: configure a cockpit weapon group on a player ship -
          the same thing the ship's weapon-configuration panel does. Weapons are
          matched by exact macro name ($w1..$w8, or 'all'); matched weapons join
          the group, unmatched eligible weapons leave it. Primary groups take
          guns, secondary groups take missile launchers (vanilla rule).
        -->
        <cue name="CoCaptain_OnSetWeaponGroup" instantiate="true">
            <conditions>
                <event_ui_triggered screen="'CoCaptainBridge'" control="'set_weapon_group'" />
            </conditions>
            <actions>
                <do_if value="event.param3.{'$ship'}?">
                    <set_value name="$ShipArg" exact="event.param3.{'$ship'}" />
                    <set_value name="$Ship" exact="null" />
                    <set_value name="$Matches" exact="0" />
                    <find_ship name="$AllShips" space="player.galaxy" owner="faction.player" multiple="true" />
                    <do_all exact="$AllShips.count" counter="$i">
                        <do_if value="$AllShips.{$i}.idcode == $ShipArg or $AllShips.{$i}.knownname == $ShipArg">
                            <set_value name="$Matches" operation="add" />
                            <do_if value="not $Ship">
                                <set_value name="$Ship" exact="$AllShips.{$i}" />
                            </do_if>
                        </do_if>
                    </do_all>
                    <do_if value="not $Ship">
                        <show_notification text="'Co-captain: no owned ship matches ' + $ShipArg" />
                    </do_if>
                    <do_elseif value="$Matches gt 1">
                        <show_notification text="'Co-captain: ' + $Matches + ' ships match ' + $ShipArg + ' - using ' + $Ship.knownname + ' ' + $Ship.idcode" />
                    </do_elseif>
                </do_if>
                <do_else>
                    <set_value name="$Ship" exact="player.occupiedship" />
                    <do_if value="not $Ship.exists or $Ship.isclass.spacesuit or not $Ship.isplayerowned">
                        <set_value name="$Ship" exact="null" />
                        <show_notification text="'Co-captain: you are not aboard a ship of ours'" />
                    </do_if>
                </do_else>
                <do_if value="$Ship">
                    <set_value name="$Group" exact="(event.param3.{'$group'})i" />
                    <set_value name="$Primary" exact="if event.param3.{'$primary'}? then event.param3.{'$primary'} else true" />
                    <set_value name="$Activate" exact="@event.param3.{'$activate'}" />
                    <do_if value="$Group lt 1 or $Group gt 4">
                        <show_notification text="'Co-captain: weapon group must be 1-4, got ' + $Group" />
                    </do_if>
                    <do_else>
                        <set_value name="$Wanted" exact="[]" />
                        <do_all exact="8" counter="$k">
                            <set_value name="$Key" exact="'$w' + $k" />
                            <do_if value="event.param3.{$Key}?">
                                <append_to_list name="$Wanted" exact="event.param3.{$Key}" />
                            </do_if>
                        </do_all>
                        <set_value name="$All" exact="$Wanted.indexof.{'all'} gt 0" />
                        <set_value name="$Added" exact="0" />
                        <set_value name="$Removed" exact="0" />
                        <do_for_each name="$W" in="$Ship.weapons.operational.list">
                            <set_value name="$IsPrimary" exact="not $W.isclass.missilelauncher" />
                            <do_if value="$IsPrimary == $Primary">
                                <set_value name="$MacroName" exact="if @$W.macro.name then $W.macro.name else ''" />
                                <do_if value="$All or $Wanted.indexof.{$MacroName} gt 0">
                                    <add_weapon_to_weapongroup weapon="$W" weapongroup="$Group" primary="$Primary" />
                                    <set_value name="$Added" operation="add" />
                                </do_if>
                                <do_else>
                                    <remove_weapon_from_weapongroup weapon="$W" weapongroup="$Group" primary="$Primary" />
                                    <set_value name="$Removed" operation="add" />
                                </do_else>
                            </do_if>
                        </do_for_each>
                        <do_if value="$Activate">
                            <activate_weapongroup object="$Ship" weapongroup="$Group" primary="$Primary" />
                        </do_if>
                        <set_value name="$Kind" exact="if $Primary then 'primary' else 'secondary'" />
                        <show_notification text="'Co-captain: ' + $Kind + ' weapon group ' + $Group + ' on ' + $Ship.knownname + ' ' + $Ship.idcode + ' = ' + $Added + ' weapons (' + $Removed + ' excluded)' + (if $Activate then ', active' else '')" />
                        <write_to_logbook category="general" title="'Co-captain order'" text="'Weapon group: ' + $Kind + ' ' + $Group + ' on ' + $Ship.knownname + ' ' + $Ship.idcode + ' set to ' + $Added + ' weapons'" />
                    </do_else>
                </do_if>
            </actions>
        </cue>

        <!--
          rekit_ship: the legitimate refit path. Creates a ship-modification
          build task at an equip-capable station (add_build_to_modify_ship
          with a loadout ID - predefined or saved by the player in the wharf
          UI) and issues the vanilla Equip order, so the ship flies there,
          docks, and is refitted by the station. Requires ship idcode/name,
          loadout id, and exact station name.
        -->
        <cue name="CoCaptain_OnRekitShip" instantiate="true">
            <conditions>
                <event_ui_triggered screen="'CoCaptainBridge'" control="'rekit_ship'" />
            </conditions>
            <actions>
                <set_value name="$ShipArg" exact="event.param3.{'$ship'}" />
                <set_value name="$Ship" exact="null" />
                <find_ship name="$AllShips" space="player.galaxy" owner="faction.player" multiple="true" />
                <do_all exact="$AllShips.count" counter="$i">
                    <do_if value="not $Ship and ($AllShips.{$i}.idcode == $ShipArg or $AllShips.{$i}.knownname == $ShipArg)">
                        <set_value name="$Ship" exact="$AllShips.{$i}" />
                    </do_if>
                </do_all>
                <do_if value="not $Ship">
                    <show_notification text="'Co-captain: no owned ship matches ' + $ShipArg" />
                </do_if>
                <do_elseif value="$Ship.pilot == player.entity">
                    <show_notification text="'Co-captain: you have the helm of ' + $Ship.knownname + ' - dock at the wharf yourself'" />
                </do_elseif>
                <do_elseif value="not @$Ship.assignedpilot">
                    <show_notification text="'Co-captain: ' + $Ship.knownname + ' has no captain to take the refit order'" />
                </do_elseif>
                <do_else>
                    <set_value name="$StationArg" exact="event.param3.{'$station'}" />
                    <set_value name="$Station" exact="null" />
                    <find_station name="$AllStations" space="player.galaxy" multiple="true" />
                    <do_all exact="$AllStations.count" counter="$i">
                        <do_if value="not $Station and $AllStations.{$i}.knownname == $StationArg and $AllStations.{$i}.canequipships">
                            <set_value name="$Station" exact="$AllStations.{$i}" />
                        </do_if>
                    </do_all>
                    <do_if value="$Station">
                        <set_value name="$LoadoutId" exact="event.param3.{'$loadout'}" />
                        <add_build_to_modify_ship object="$Station" buildobject="$Ship" loadout="$LoadoutId" result="$Build" />
                        <do_if value="$Build">
                            <create_order object="$Ship" id="'Equip'" immediate="true">
                                <param name="build" value="$Build" />
                            </create_order>
                            <show_notification text="'Co-captain: ' + $Ship.knownname + ' ' + $Ship.idcode + ' ordered to refit at ' + $Station.knownname + ' with loadout ' + $LoadoutId" />
                            <write_to_logbook category="general" title="'Co-captain order'" text="'Refit: ' + $Ship.knownname + ' ' + $Ship.idcode + ' to loadout ' + $LoadoutId + ' at ' + $Station.knownname" />
                        </do_if>
                        <do_else>
                            <show_notification text="'Co-captain: refit build failed - is loadout ' + $LoadoutId + ' valid for ' + $Ship.knownname + '?'" />
                        </do_else>
                    </do_if>
                    <do_else>
                        <show_notification text="'Co-captain: no equip-capable station named ' + $StationArg" />
                    </do_else>
                </do_else>
            </actions>
        </cue>

        <!--
          Fleet telemetry: every 30s, sweep all player-owned ships into the
          player-entity blackboard var $cocaptain_fleet. ui/ea.lua reads it
          back via GetNPCBlackboard (keys arrive in Lua with the $ stripped)
          and attaches it to the telemetry POST as `fleet` when it changes.
          Same instantiate+checkinterval pattern as the stock EA_callMessages.
        -->
        <cue name="CoCaptain_FleetSweep" instantiate="true" checkinterval="30s">
            <actions>
                <find_ship name="$Ships" space="player.galaxy" owner="faction.player" multiple="true" />
                <set_value name="$Fleet" exact="[]" />
                <do_all exact="$Ships.count" counter="$i">
                    <set_value name="$S" exact="$Ships.{$i}" />
                    <do_if value="$S.exists">
                        <set_value name="$Size" exact="'S'" />
                        <do_if value="$S.isclass.ship_xl">
                            <set_value name="$Size" exact="'XL'" />
                        </do_if>
                        <do_elseif value="$S.isclass.ship_l">
                            <set_value name="$Size" exact="'L'" />
                        </do_elseif>
                        <do_elseif value="$S.isclass.ship_m">
                            <set_value name="$Size" exact="'M'" />
                        </do_elseif>
                        <set_value name="$Purpose" exact="'other'" />
                        <do_if value="$S.primarypurpose == purpose.fight">
                            <set_value name="$Purpose" exact="'fight'" />
                        </do_if>
                        <do_elseif value="$S.primarypurpose == purpose.trade">
                            <set_value name="$Purpose" exact="'trade'" />
                        </do_elseif>
                        <do_elseif value="$S.primarypurpose == purpose.mine">
                            <set_value name="$Purpose" exact="'mine'" />
                        </do_elseif>
                        <do_elseif value="$S.primarypurpose == purpose.auxiliary">
                            <set_value name="$Purpose" exact="'auxiliary'" />
                        </do_elseif>
                        <do_elseif value="$S.primarypurpose == purpose.build">
                            <set_value name="$Purpose" exact="'build'" />
                        </do_elseif>
                        <do_elseif value="$S.primarypurpose == purpose.salvage">
                            <set_value name="$Purpose" exact="'salvage'" />
                        </do_elseif>
                        <append_to_list name="$Fleet" exact="table[
                            $idcode = $S.idcode,
                            $name = $S.knownname,
                            $size = $Size,
                            $purpose = $Purpose,
                            $hull = ($S.hullpercentage)i,
                            $shield = ($S.shieldpercentage)i,
                            $sector = if $S.sector.exists then $S.sector.knownname else '',
                            $x = if @$S.dock.exists then 0 else ($S.position.x / 1km)i,
                            $y = if @$S.dock.exists then 0 else ($S.position.y / 1km)i,
                            $z = if @$S.dock.exists then 0 else ($S.position.z / 1km)i,
                            $docked = if @$S.dock.exists then true else false,
                            $order = if @$S.order.id then $S.order.id else '',
                            $commander = if @$S.commander.exists then $S.commander.knownname else '',
                            $captain = if @$S.pilot.exists then $S.pilot.knownname else '',
                            $has_captain = if @$S.pilot.exists then true else false,
                            $sector_known = if $S.sector.exists then $S.sector.isknown else false,
                            $operational = if $S.isoperational then true else false,
                            $is_player_ship = if $S == player.occupiedship then true else false
                        ]" />
                    </do_if>
                </do_all>
                <set_value name="player.entity.$cocaptain_fleet" exact="$Fleet" />
            </actions>
        </cue>
    </cues>
</mdscript>
